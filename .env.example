NODE_ENV=development
PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=online_store
DATABASE_PASSWORD=online_store
DATABASE_NAME=online_store
DATABASE_SSL=false
DATABASE_LOGGING=false

# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

JWT_ACCESS_SECRET=change_me_min_16_chars
JWT_ACCESS_TTL=900s
REFRESH_TTL_DAYS=7

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

STORAGE_DIR=storage/uploads
STORAGE_DRIVER=local
# Set STORAGE_DRIVER=s3 in production. S3 uses the AWS default credential chain
# (env vars locally, task IAM role / SecretsManager-injected env on ECS) — never put keys here.
# S3_BUCKET=
# AWS_REGION=eu-central-1
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false

CORS_ORIGIN=http://localhost:3000

BODY_LIMIT=256kb

PAYMENT_PROVIDER=mock
# WayForPay test shop credentials; set PAYMENT_PROVIDER=wayforpay to enable
# WAYFORPAY_MERCHANT_ACCOUNT=
# WAYFORPAY_SECRET_KEY=
# WAYFORPAY_DOMAIN=www.example.com
PUBLIC_API_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3000

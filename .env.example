# WAYFORPAY_MERCHANT_ACCOUNT=
# WAYFORPAY_SECRET_KEY=
# WAYFORPAY_DOMAIN=www.example.com
PUBLIC_API_URL=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3000
